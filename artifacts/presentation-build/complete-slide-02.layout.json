{"id":"sh/q5wjelsz","kind":"textbox","name":"Introduction headline","position":{"left":72,"top":132,"width":790,"height":100},"text":"Communication and coordination\nfor event teams","style":{"fontSize":42,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ove9o7yd","kind":"textbox","name":"Event context","position":{"left":72,"top":266,"width":770,"height":108},"text":"Event teams work across different floors and zones. They need to reach the right people quickly and know who is handling each reported issue.","style":{"fontSize":27,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/9wnqhczy","kind":"textbox","name":"Project introduction","position":{"left":72,"top":399,"width":770,"height":124},"text":"Kettoo is a private platform for organisers and volunteers. It combines walkie-talkie voice and messaging with venue check-ins and issue tracking in an Android app and a browser console.","style":{"fontSize":27,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/mtwrmxg7","kind":"textbox","name":"Continuity during outages","position":{"left":72,"top":564,"width":770,"height":72},"text":"Local queues and direct Nearby communication help approved Android phones continue during outages.","style":{"fontSize":24,"typeface":"Arial","color":"#555555","alignment":"left"},"geometry":"rect","lineWidth":0},
