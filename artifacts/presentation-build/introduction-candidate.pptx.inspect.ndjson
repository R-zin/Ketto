{"kind":"textbox","id":"sh/ove9o7yd","slideIndex":1,"position":{"left":72,"top":266,"width":770,"height":108},"name":"Event context","text":"Event teams work across different floors and zones. They need to reach the right people quickly and know who is handling each reported issue.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Arial","color":"#262626","alignment":"left"}}
