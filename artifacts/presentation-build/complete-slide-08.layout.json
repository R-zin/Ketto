{"id":"sh/id0fu50z","kind":"textbox","name":"Content headline","position":{"left":72,"top":128,"width":1130,"height":108},"text":"A working prototype with evidence\nand a clear path to venue acceptance","style":{"fontSize":40,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/o7ydoret","kind":"textbox","name":"Impact section","position":{"left":72,"top":268,"width":515,"height":36},"text":"Intended operational impact","style":{"fontSize":29,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/98rehwve","kind":"textbox","name":"Impact content","position":{"left":72,"top":328,"width":518,"height":279},"text":"Route requests to permitted teams.\n\nGive each issue a visible owner and status.\n\nKeep voice reports available for replay and acknowledgement.\n\nLet organisations host their data and services.","style":{"fontSize":27,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/m5gvmhwn","kind":"textbox","name":"Feasibility section","position":{"left":675,"top":268,"width":521,"height":36},"text":"Feasibility and scalability","style":{"fontSize":29,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/n6pwfmd8","kind":"textbox","name":"Feasibility content","position":{"left":675,"top":328,"width":521,"height":264},"text":"34/34 backend tests passed in the recorded verification run.\n\nTwo physical Android phones completed direct Nearby outage/recovery tests.\n\nAndroid, browser and server components have build and device evidence.","style":{"fontSize":27,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/0jydkreh","kind":"textbox","name":"Scalability qualification","position":{"left":72,"top":630,"width":1122,"height":61},"text":"Venue-scale load, radio range, longer duty sessions and deployment acceptance remain to be tested. No staff-capacity or response-time claim yet.","style":{"fontSize":23,"typeface":"Arial","color":"#555555","alignment":"left"},"geometry":"rect","lineWidth":0}
