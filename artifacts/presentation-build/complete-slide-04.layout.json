{"id":"sh/i94r6xgz","kind":"textbox","name":"Solution detail 0","position":{"left":72,"top":397,"width":780,"height":65},"text":"Use channel PTT, duty-admin exchanges and targeted broadcasts.","style":{"fontSize":25,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/jadsz2xk","kind":"textbox","name":"Solution label 1","position":{"left":72,"top":470,"width":780,"height":32},"text":"Keep each report actionable","style":{"fontSize":26,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
