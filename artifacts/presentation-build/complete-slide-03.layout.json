{"id":"sh/n6ls3alk","kind":"textbox","name":"Content headline","position":{"left":72,"top":128,"width":1130,"height":108},"text":"A spoken request still needs\na location, an owner and a record","style":{"fontSize":40,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/n2l4fq98","kind":"textbox","name":"Operating scenario","position":{"left":72,"top":263,"width":1100,"height":92},"text":"During an event, volunteers work in different zones. A request for help needs to reach the right team and remain visible until someone resolves it.","style":{"fontSize":28,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/m1c3mlsn","kind":"textbox","name":"Problem 1","position":{"left":72,"top":384,"width":375,"height":36},"text":"Reaching the right people","style":{"fontSize":27,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/943mhgre","kind":"textbox","name":"Problem detail 1","position":{"left":483,"top":384,"width":695,"height":72},"text":"Separate conversations can make urgent updates difficult to route.","style":{"fontSize":26,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/83ulovat","kind":"textbox","name":"Problem 2","position":{"left":72,"top":480,"width":375,"height":36},"text":"Keeping track of responsibility","style":{"fontSize":27,"typeface":"Arial","color":"#262626","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/v6l4jq94","kind":"textbox","name":"Problem detail 2","position":{"left":483,"top":480,"width":695,"height":72},"text":"A voice exchange alone does not show who owns an issue or whether it is resolved.","style":{"fontSize":26,"typeface":"Arial","color":"#262626","alignment":"left"},"geometry":"rect","lineWidth":0},
